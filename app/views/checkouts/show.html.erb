<section class="demo-hero">
  <div>
    <p class="eyebrow">Demo de Feature Flag</p>
    <h1>Checkout controlado por flag</h1>
    <p>
      O mesmo deploy contém as duas versões. A decisão de release acontece pela flag
      <strong>new_checkout</strong>.
    </p>
  </div>

  <%= link_to "Controlar flags", feature_flags_path, class: "button secondary" %>
</section>

<main class="checkout-grid">
  <section class="checkout-panel <%= @new_checkout_enabled ? "checkout-new" : "checkout-current" %>">
    <p class="eyebrow"><%= @new_checkout_enabled ? "Flag ligada" : "Flag desligada" %></p>
    <h2><%= @new_checkout_enabled ? "Novo checkout" : "Checkout atual" %></h2>

    <% if @new_checkout_enabled %>
      <div class="checkout-steps">
        <span>1. Carrinho</span>
        <span>2. Entrega</span>
        <span>3. Pagamento</span>
      </div>
      <p>
        A nova experiência mostra etapas claras, resumo fixo e chamada de pagamento
        mais direta para o cliente piloto.
      </p>
      <button class="pay-button">Pagar com checkout novo</button>
    <% else %>
      <p>
        Esta é a experiência estável que todos já utilizam enquanto a nova versão
        permanece protegida pela flag.
      </p>
      <button class="pay-button">Finalizar compra</button>
    <% end %>
  </section>

  <aside class="flag-panel">
    <h2>Decisão da flag</h2>
    <dl>
      <div>
        <dt>Cliente</dt>
        <dd>#<%= @customer_id %></dd>
      </div>
      <div>
        <dt>Flag</dt>
        <dd><%= @flag["enabled"] ? "ON" : "OFF" %></dd>
      </div>
      <div>
        <dt>Rollout</dt>
        <dd><%= @flag["rollout_percentage"] %>%</dd>
      </div>
    </dl>

    <%= form_with url: checkout_path, method: :get, class: "inline-form" do |form| %>
      <%= form.label :customer_id, "Simular cliente" %>
      <%= form.number_field :customer_id, value: @customer_id, min: 1 %>
      <%= form.submit "Ver checkout", class: "button" %>
    <% end %>
  </aside>
</main>
