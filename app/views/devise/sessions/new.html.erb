<main class="auth-page">
  <section class="auth-panel">
    <div class="auth-copy">
      <p class="eyebrow">Feature Flag Store</p>
      <h1>Entrar</h1>
      <p>Acesse a loja demo para adicionar produtos ao carrinho e testar a flag de cupons.</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "auth-form" }) do |form| %>
      <div class="field">
        <%= form.label :email, "E-mail" %>
        <%= form.email_field :email, autofocus: true, autocomplete: "email", placeholder: "aluno@example.com" %>
      </div>

      <div class="field">
        <%= form.label :password, "Senha" %>
        <%= form.password_field :password, autocomplete: "current-password", placeholder: "password123" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="check-row">
          <%= form.check_box :remember_me %>
          <span>Lembrar acesso</span>
        </label>
      <% end %>

      <%= form.submit "Entrar", class: "button full" %>
    <% end %>

    <div class="auth-links">
      <%= link_to "Criar conta", new_registration_path(resource_name) %>
      <%= link_to "Voltar para loja", root_path %>
    </div>
  </section>
</main>
